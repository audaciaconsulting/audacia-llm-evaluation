# API key vars are optional for the LLM and embedding models: if left unset,
# authentication falls back to Entra ID (DefaultAzureCredential — az login /
# managed identity), required for resources with disableLocalAuth=true.
# (Promptfoo is the exception — its API key is required.)

LLM_EVAL_LLM_MODEL=
LLM_EVAL_LLM_ENDPOINT=
LLM_EVAL_LLM_API_VERSION=
LLM_EVAL_LLM_API_KEY=

LLM_EVAL_EMBEDDING_MODEL=
LLM_EVAL_EMBEDDING_MODEL_ENDPOINT=
LLM_EVAL_EMBEDDING_MODEL_API_VERSION=
LLM_EVAL_EMBEDDING_MODEL_API_KEY=

LLM_EVAL_PROMPTFOO_LLM_MODEL=
LLM_EVAL_PROMPTFOO_LLM_API_ENDPOINT=
LLM_EVAL_PROMPTFOO_LLM_API_KEY=
